/* pages/login/login.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background-color: #f0f2f5;
}

.logo-image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

/* 登录卡片样式 */
.login-card {
  width: 80%;
  background-color: white;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  z-index: 1;
  position: relative;
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.login-tabs {
  display: flex;
  border-bottom: 1rpx solid #e0e0e0;
  margin-bottom: 30rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #4472C4;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background-color: #4472C4;
  border-radius: 2rpx;
}

.form {
  padding: 0 20rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #e0e0e0;
  padding-bottom: 10rpx;
}

.input-icon {
  margin-right: 20rpx;
  color: #999;
}

.input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.remember-password {
  display: flex;
  align-items: center;
  margin: 20rpx 0 40rpx;
}

.remember-password text {
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
}

.login-button {
  background-color: #4472C4;
  color: white;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 100%;
}

.wechat-login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
}

.wechat-tip {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  text-align: center;
}

.wechat-login-button {
  background-color: #07c160;
  color: white;
  border: none;
  border-radius: 10rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  background-image: url('data:image/svg+xml;base64,');
  background-size: contain;
  background-repeat: no-repeat;
}

.login-description {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 30rpx;
}

.wave-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  overflow: hidden;
}

.wave {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-repeat: repeat-x;
  animation: wave 10s linear infinite;
}

.wave1 {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%234472C4" fill-opacity="0.5" d="M0,96L48,112C96,128,192,160,288,154.7C384,149,480,107,576,112C672,117,768,171,864,197.3C960,224,1056,224,1152,202.7C1248,181,1344,139,1392,117.3L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>');
  animation-duration: 12s;
  opacity: 0.7;
}

.wave2 {
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="%234472C4" fill-opacity="0.7" d="M0,64L48,96C96,128,192,192,288,197.3C384,203,480,149,576,144C672,139,768,181,864,197.3C960,213,1056,203,1152,186.7C1248,171,1344,149,1392,138.7L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>');
  animation-duration: 8s;
  animation-delay: -2s;
}

@keyframes wave {
  0% {
    background-position-x: 0;
  }
  100% {
    background-position-x: 1440px;
  }
}

.page-footer {
  position: absolute;
  bottom: 30rpx;
  width: 100%;
  text-align: center;
  z-index: 2;
}

.copyright {
  font-size: 24rpx;
  color: white;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
}